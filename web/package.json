{
  "name": "ai-video-factory-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "tsc -b --noEmit",
    "test": "vitest",
    "test:e2e": "playwright test",
    "generate:api": "python ../scripts/dump_openapi.py && openapi-typescript openapi.json -o src/api/generated.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.90.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.9.4"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "jsdom": "27.0.1",
    "msw": "2.12.4",
    "openapi-typescript": "7.10.1",
    "typescript": "5.9.3",
    "vite": "7.2.4",
    "vitest": "3.2.4"
  }
}
